{
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/refresh-corpus",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ingest-funders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/ingest-region-sources",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/refresh-propublica",
      "schedule": "0 4 * * *"
    }
  ]
}
